# Copy to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored - never commit it.

# --- Azure basics ---
location            = "eastus"
resource_group_name = "rg-driftwood-citrix-daas"

# This is a temporary demo environment, torn down after the conference -
# every Terraform-managed VM (domain controllers, Cloud Connectors, the
# GitHub runner) gets Azure's native auto-shutdown schedule by default so
# nothing keeps costing money if left running by accident. Doesn't cover
# Citrix MCS-provisioned VDAs (see delivery_groups' power_time_schemes
# below for those) - see scripts/manage-demo-vms.ps1 for ad-hoc start/stop
# of everything, VDAs included.
enable_scheduled_shutdown   = true
scheduled_shutdown_time     = "1900"
scheduled_shutdown_timezone = "Eastern Standard Time"

# Console screenshot + serial log on every Terraform-managed VM - useful
# while the environment's still being stood up/validated. Doesn't cover
# Citrix MCS-provisioned VDAs (the citrix provider exposes no equivalent
# setting for those). Safe to flip to false once the environment's proven.
enable_boot_diagnostics = true

# --- Networking ---
vnet_name                   = "vnet-driftwood-citrix-daas"
vnet_address_space          = ["10.50.0.0/16"]
vda_subnet_address_prefixes = ["10.50.1.0/24"]

# Leave both off by default - this subscription has no Bastion/VPN/jump host,
# so there's normally no way to reach the runner VM's private IP at all.
# Temporarily flip enable_runner_temporary_ssh_access to true + set your
# current IP below only while registering the runner (see
# bootstrap-github-runner-commands.txt), then set it back to false and
# re-apply.
enable_runner_temporary_ssh_access = false
# admin_source_ip_cidr = "203.0.113.5/32"

# --- Azure identity (from the techops Azure meeting) ---
azure_subscription_id = "00000000-0000-0000-0000-000000000000"
azure_tenant_id        = "00000000-0000-0000-0000-000000000000"

# --- Citrix Cloud (from the techops Citrix Cloud meeting) ---
citrix_customer_id = "your-citrix-customer-id"
citrix_client_id    = "your-citrix-api-client-id"
citrix_environment  = "Production"
# citrix_client_secret is intentionally NOT a variable here - export it as the
# CITRIX_CLIENT_SECRET environment variable instead (see providers.tf).

# --- Citrix DaaS naming ---
citrix_resource_location_name = "driftwood-azure-eastus"
citrix_hypervisor_name        = "driftwood-azure-hyperv"
citrix_resource_pool_name     = "driftwood-azure-resource-pool"
# Admin folder in Citrix Studio/Web Studio this environment's machine
# catalogs and delivery groups are placed in, alongside other environments/
# customers' own folders.
citrix_admin_folder_name = "Driftwood"

# --- Golden image pipeline (see ../../packer) ---
gallery_name           = "driftwoodcitrixgallery"
image_definition_name  = "win11-vda"
image_sku              = "win11-vda"

# --- Image build artifact storage (VDA installer, Citrix Optimizer zip) ---
artifact_storage_account_name   = "driftwoodctximages"
artifact_storage_container_name = "image-build-artifacts"

# --- Golden image versioning / machine catalog rotation ---
# catalog_rotation is NOT set here - it's sourced from the git-tracked
# rotation.auto.tfvars.json (Terraform auto-loads *.auto.tfvars.json), which
# the citrix-image-rotation workflow updates each month, per environment. See
# that file and .github/workflows/citrix-image-rotation.yml. Do not also set
# catalog_rotation in your real terraform.tfvars - Terraform will error on
# the duplicate.

citrix_allocation_type      = "Random"
citrix_vda_service_offering = "Standard_D4s_v5"
citrix_vda_storage_type     = "StandardSSD_LRS"

# --- Delivery groups: one per environment (Dev/Test/Prod), each with its own
# name, published desktop, access list, autoscale schedule, and the
# catalog-naming conventions citrix-image-rotation.yml seeds new builds with.
# Access list entries are AD groups in "<NETBIOS>\<GroupName>" form -
# modules/domain-controllers creates the three groups referenced below
# automatically (see active_directory_dev/test/prod_desktop_group_name
# below), so these values work as-is once the domain is stood up.
delivery_groups = {
  dev = {
    name                                  = "Driftwood Ale Works - Development"
    published_desktop_name                = "Driftwood Dev Desktop"
    desktop_restricted_access_allow_list  = ["DRIFTWOOD\\Driftwood Dev Desktop Users"]
    autoscale_enabled                     = true
    autoscale_timezone                    = "Eastern Standard Time"
    catalog_name_prefix                   = "driftwood-win11-dev"
    machine_naming_scheme                 = "dw-dev-vda-##"
    # Dev is self-service and cost-sensitive - narrow weekday ramp, nothing
    # powered on outside business hours or on weekends.
    power_time_schemes = [
      {
        days_of_week          = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
        display_name          = "Dev weekday hours"
        peak_time_ranges      = ["08:00-18:00"]
        pool_using_percentage = true
        pool_size_schedules = [
          { time_range = "08:00-18:00", pool_size = 50 },
        ]
      }
    ]
  }

  test = {
    name                                  = "Driftwood Ale Works - QA Testing"
    published_desktop_name                = "Driftwood QA Desktop"
    desktop_restricted_access_allow_list  = ["DRIFTWOOD\\Driftwood QA Desktop Users"]
    autoscale_enabled                     = true
    autoscale_timezone                    = "Eastern Standard Time"
    catalog_name_prefix                   = "driftwood-win11-test"
    machine_naming_scheme                 = "dw-test-vda-##"
    # QA needs a slightly wider window than dev to cover test-cycle overlap
    # with other time zones, still off outside business hours/weekends.
    power_time_schemes = [
      {
        days_of_week          = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
        display_name          = "QA weekday hours"
        peak_time_ranges      = ["07:00-19:00"]
        pool_using_percentage = true
        pool_size_schedules = [
          { time_range = "07:00-19:00", pool_size = 60 },
        ]
      }
    ]
  }

  prod = {
    name                                  = "Driftwood Ale Works - Production"
    published_desktop_name                = "Driftwood Ale Works Desktop"
    desktop_restricted_access_allow_list  = ["DRIFTWOOD\\Driftwood Prod Desktop Users"]
    autoscale_enabled                     = true
    autoscale_timezone                    = "Central Standard Time"
    catalog_name_prefix                   = "driftwood-win11-prod"
    machine_naming_scheme                 = "dw-prod-vda-##"
    # This is a temporary demo environment (torn down after the
    # conference), not real production traffic - nothing powered on outside
    # business hours (weekdays only; nothing on weekends either). Assumed
    # weekdays-only to match Dev/Test's pattern - widen days_of_week below
    # if you actually want weekend coverage.
    power_time_schemes = [
      {
        days_of_week          = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
        display_name          = "Prod weekday business hours - Central"
        peak_time_ranges      = ["08:00-17:00"]
        pool_using_percentage = true
        pool_size_schedules = [
          { time_range = "08:00-10:00", pool_size = 20 },
          { time_range = "10:00-17:00", pool_size = 10 },
        ]
      }
    ]
  }
}

# --- Active Directory (new forest - modules/domain-controllers,
# modules/cloud-connectors, modules/citrix). Defaults are demo-ready; the
# passwords below are placeholders you must fill in yourself, never commit
# a real value. ---
active_directory_domain_fqdn         = "driftwood.local"
active_directory_domain_netbios_name = "DRIFTWOOD"
active_directory_safe_mode_password  = "REPLACE_ME"
active_directory_service_account_password = "REPLACE_ME"
# active_directory_service_account_name, _base_ou_name, _vda_ou_name,
# _connector_ou_name, and _{dev,test,prod}_desktop_group_name all have
# sensible defaults (see variables.tf) - override only if you want different
# names.

# --- Domain controllers (modules/domain-controllers) ---
domain_controller_admin_username = "dcadmin"
domain_controller_admin_password = "REPLACE_ME"
# domain_controller_scripts_storage_account_name defaults to
# "driftwooddcscripts" - must be globally unique across all of Azure, change
# it if that name is already taken.

# --- Cloud Connectors (modules/cloud-connectors) ---
cloud_connector_admin_username = "ctxadmin"
cloud_connector_admin_password = "REPLACE_ME"
# A Citrix Cloud API client dedicated to Cloud Connector registration -
# create a "Secure Client" in Citrix Cloud > Identity and Access Management
# > API Access, separate from citrix_client_id above.
cloud_connector_client_id     = "your-cloud-connector-api-client-id"
cloud_connector_client_secret = "REPLACE_ME"
# Upload the Cloud Connector installer to the artifact-storage container
# (see modules/cloud-connectors/README.md), then generate a read-only SAS
# URL for it.
cloud_connector_installer_url = "https://driftwoodctximages.blob.core.windows.net/image-build-artifacts/CWCConnector.exe?REPLACE_ME_SAS_TOKEN"
# cloud_connector_scripts_storage_account_name defaults to
# "driftwoodccscripts" - must be globally unique, change it if taken.

# --- Self-hosted GitHub Actions runner (for citrix-image-rotation.yml) ---
github_runner_name    = "driftwood-gh-runner"
github_runner_vm_size = "Standard_B2s"
# github_runner_admin_ssh_public_key is your public key, e.g. the contents of
# ~/.ssh/id_ed25519.pub - not secret, but fill in a real value.
github_runner_admin_ssh_public_key = "ssh-ed25519 AAAA..."
