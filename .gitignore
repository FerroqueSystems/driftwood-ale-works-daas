# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# ...except the golden-image/machine-catalog rotation state, which is
# deliberately non-secret (just build labels/counts) and git-tracked so the
# citrix-image-rotation workflow's changes are reviewable/auditable.
!environments/citrix-azure/rotation.auto.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Saved plan output (terraform plan -out=...) - can contain full state/config
# snapshots, never commit these
*tfplan*
initplan

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout

# Packer - variable files containing real build values/credentials (keep only *.example templates tracked)
packer/**/*.pkrvars.hcl
!packer/**/*.pkrvars.hcl.example
packer/**/*.auto.pkrvars.json
packer_cache/
packer/scripts/*.ps1
!packer/scripts/README.md